//CELL FILE.. ReRAM-4T2R-VLSIC14

-MemCellType: memristor
# TCAM/MCAM/ACAM
-CAMType: TCAM
-ProcessNode: 40
-CellArea (F^2): 299
-CellAspectRatio: 1.6
-AccessType: CMOS
-AccessCMOSWidth (F): 3.0
-VoltageDropAccessDevice (V): 0.15
-isNVMdischarge:  false

//-SRAMCellNMOSWidth (F): 
//-SRAMCellPMOSWidth (F): 

-ResistanceOn (ohm): 400
-ResistanceOff (ohm): 300000

//-CapacitanceOn (F): 
//-CapacitanceOff (F): 

-ReadMode: current
//-ReadVoltage (V): 0.25
-ReadCurrent (uA): 50
-ReadPower (uW): 30
-MinSenseVoltage (mV): 25
-ResetMode: current
//-ResetVoltage (V):
-ResetCurrent (uA): 150
-ResetPulse (ns): 10
-ResetEnergy (pJ): 1
-SetMode: current
//-SetVoltage (V): 
-SetCurrent (uA): 150
-SetPulse (ns): 10
-SetEnergy (pJ): 1



